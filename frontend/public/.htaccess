# =====================================================================
# VirtualProperty.my — Apache config for Hostinger (production)
# Static one-page site. NOTE: this file only takes effect on Apache
# (Hostinger). The Emergent preview dev server ignores .htaccess.
# =====================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Force HTTPS + canonical non-www (single hop) ---
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://virtualproperty.my%{REQUEST_URI} [R=301,L]

    # --- Legacy URL migration (permanent 301, single hop, no chains) ---
    RewriteRule ^service-list/?$                                    https://virtualproperty.my/#what-we-do [R=301,L,NE]
    RewriteRule ^about-virtual-tour/?$                              https://virtualproperty.my/#knowledge  [R=301,L,NE]
    RewriteRule ^3d-rendering/?$                                    https://virtualproperty.my/#what-we-do [R=301,L,NE]
    RewriteRule ^agencies-developers/?$                            https://virtualproperty.my/#who-we-help [R=301,L,NE]
    RewriteRule ^guides/?$                                          https://virtualproperty.my/#knowledge  [R=301,L,NE]
    RewriteRule ^virtual-site-visits/?$                            https://virtualproperty.my/#experiences [R=301,L,NE]

    # Removed property-portal / discontinued content -> homepage
    RewriteRule ^camera-rental/?$                                              https://virtualproperty.my/ [R=301,L]
    RewriteRule ^agents/?$                                                     https://virtualproperty.my/ [R=301,L]
    RewriteRule ^for-sale/?$                                                   https://virtualproperty.my/ [R=301,L]
    RewriteRule ^for-rent/?$                                                   https://virtualproperty.my/ [R=301,L]
    RewriteRule ^characteristics-of-good-property-agent-in-malaysia/?$         https://virtualproperty.my/ [R=301,L]

    # --- Legacy WordPress lockdown (extra defense while old WP is removed) ---
    # Return 410 Gone so search engines drop these old paths, and block
    # common WordPress attack/scan targets. This static site uses no WordPress.
    RewriteRule ^(wp-admin|wp-includes|wp-content|wp-json)(/.*)?$   - [G,NC]
    RewriteRule ^(wp-login\.php|wp-signup\.php|wp-cron\.php|xmlrpc\.php|wp-config\.php)$   - [G,NC]
    RewriteRule ^(wp-.*\.php)$   - [G,NC]
    RewriteCond %{QUERY_STRING} (^|&)author=\d [NC]
    RewriteRule ^ - [G]
</IfModule>

# --- Genuine 404 for anything that isn't a real file/page ---
ErrorDocument 404 /404.html

# --- Security headers ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Caching (hashed static assets can be cached long; HTML is fresh) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
